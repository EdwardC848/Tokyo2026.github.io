        let currentFlightGroup = 1;
        let activeDay = 'all';

        function setFlightGroup(groupNum) {
            currentFlightGroup = groupNum;
            const btn1 = document.getElementById('group-btn-1');
            const btn2 = document.getElementById('group-btn-2');

            if (groupNum === 1) {
                btn1.className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 border border-gold-400/50 bg-gold-500 text-indigo-950 shadow";
                btn2.className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 border border-slate-700 bg-indigo-900 text-slate-300 hover:bg-indigo-800";
            } else {
                btn2.className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 border border-gold-400/50 bg-gold-500 text-indigo-950 shadow";
                btn1.className = "flex-1 sm:flex-none px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 border border-slate-700 bg-indigo-900 text-slate-300 hover:bg-indigo-800";
            }

            renderContent(activeDay);
        }

        function renderSingleDayHTML(dayNum) {
            const data = itineraryData[dayNum];
            if (!data) return '';

            let routeNodesHTML = '';
            data.routeNodes.forEach((node, idx) => {
                routeNodesHTML += `
                    <div class="flex items-center">
                        <div class="bg-indigo-900 border border-gold-400/50 px-3 py-1.5 rounded-xl text-center shadow">
                            <div class="text-xs font-bold text-white">${node.name}</div>
                            <div class="text-[10px] text-gold-300">${node.time}</div>
                        </div>
                        ${idx < data.routeNodes.length - 1 ? `
                            <div class="px-2 text-gold-400 flex items-center">
                                <i class="fa-solid fa-chevron-right text-xs"></i>
                            </div>
                        ` : ''}
                    </div>
                `;
            });

            let timelineHTML = '';
            data.timeline.forEach((item) => {
                const hasDrawer = item.spotKey && spotsDatabase[item.spotKey];
                let isGroupSpecific = false;
                if (dayNum === 18 && item.time.includes('第一組') && currentFlightGroup === 2) {
                    isGroupSpecific = true;
                }
                if (dayNum === 18 && item.time.includes('第二組') && currentFlightGroup === 1) {
                    isGroupSpecific = true;
                }
                if (dayNum === 19 && currentFlightGroup === 1) {
                    isGroupSpecific = true;
                }

                timelineHTML += `
                    <div class="relative z-10 mb-6 pl-8 sm:pl-12 ${isGroupSpecific ? 'opacity-35 grayscale' : ''}">
                        <div class="absolute left-1 sm:left-2 top-1.5 w-5 h-5 rounded-full bg-indigo-950 border-4 ${hasDrawer ? 'border-gold-400' : 'border-slate-500'} flex items-center justify-center"></div>
                        
                        <div class="${hasDrawer ? 'glass-panel-gold' : 'glass-panel'} rounded-xl p-4 sm:p-5 transition duration-200">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold ${hasDrawer ? 'bg-gold-500/20 text-gold-300 border border-gold-400/40' : 'bg-slate-800 text-slate-300 border border-slate-700'}">
                                    <i class="fa-regular fa-clock mr-1"></i> ${item.time}
                                </span>
                                <span class="text-xs text-slate-400"><i class="fa-solid fa-location-dot text-red-400"></i> ${item.location}</span>
                            </div>

                            <h3 class="text-base sm:text-lg font-bold text-white mb-2 flex items-center gap-2">
                                ${item.location}
                                ${hasDrawer ? `<span class="text-[11px] bg-gold-500 text-indigo-950 px-2 py-0.5 rounded-full font-bold">精選景點</span>` : ''}
                            </h3>

                            <p class="text-slate-300 text-xs sm:text-sm mb-3 leading-relaxed">
                                ${item.desc}
                            </p>

                            ${hasDrawer ? `
                                <button onclick="openDrawer('${item.spotKey}')" class="inline-flex items-center gap-1.5 px-3 py-1 bg-gold-500/10 hover:bg-gold-500/20 border border-gold-400/50 text-gold-300 text-xs font-bold rounded-lg transition mb-2">
                                    <i class="fa-solid fa-circle-info"></i> 㩒一下打開側面板了解詳情 (${item.spotKey})
                                </button>
                            ` : ''}

                            <div class="mt-2 bg-indigo-950/60 rounded-lg p-2 text-xs text-slate-300 flex items-center gap-2 border border-slate-800">
                                <i class="fa-solid fa-train-subway text-gold-400"></i>
                                <span><strong>交通方式：</strong> ${item.transport}</span>
                            </div>
                        </div>
                    </div>
                `;
            });

            if (dayNum === 19 && currentFlightGroup === 1) {
                timelineHTML += `
                    <div class="glass-panel rounded-xl p-6 text-center my-4">
                        <i class="fa-solid fa-plane text-4xl text-gold-400 mb-3"></i>
                        <h3 class="text-lg font-bold text-white mb-2">第一組行程已於昨日 (12/18 21:00) 圓滿結束回港</h3>
                        <p class="text-xs text-slate-300">切換上方按鈕至「第二組」可預覽 12/19 成田山新勝寺半日遊。</p>
                    </div>
                `;
            }

            return `
                <div class="mb-10">
                    <div class="glass-panel rounded-2xl p-5 mb-6">
                        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                            <div>
                                <span class="px-3 py-1 bg-gold-500/20 text-gold-300 border border-gold-400/40 text-xs font-bold rounded-full">
                                    ${data.badge}
                                </span>
                                <h2 class="text-xl sm:text-2xl font-extrabold text-white mt-1">
                                    ${data.date}：${data.title}
                                </h2>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-slate-700/60">
                            <div class="text-xs text-slate-400 mb-2 font-medium"><i class="fa-solid fa-route text-gold-400"></i> 移動順序 (Route Flow)</div>
                            <div class="flex overflow-x-auto gap-1 pb-2 scrollbar-thin">
                                ${routeNodesHTML}
                            </div>
                        </div>
                    </div>

                    <div class="relative">
                        <div class="absolute left-3.5 sm:left-4 top-2 bottom-2 w-0.5 bg-gradient-to-b from-gold-400 via-sky-400 to-indigo-800"></div>
                        ${timelineHTML}
                    </div>
                </div>
            `;
        }

        function renderContent(dayKey) {
            activeDay = dayKey;

            document.querySelectorAll('.day-tab').forEach(tab => {
                tab.classList.remove('bg-gold-500', 'text-indigo-950', 'shadow-lg');
                tab.classList.add('bg-indigo-900', 'text-slate-300');
            });
            const activeTab = document.getElementById(`tab-${dayKey}`);
            if (activeTab) {
                activeTab.classList.remove('bg-indigo-900', 'text-slate-300');
                activeTab.classList.add('bg-gold-500', 'text-indigo-950', 'shadow-lg');
            }

            const container = document.getElementById('day-content');

            if (dayKey === 'all') {
                let allHTML = '';
                for (let d = 10; d <= 19; d++) {
                    allHTML += renderSingleDayHTML(d);
                }
                container.innerHTML = allHTML;
            } else {
                container.innerHTML = renderSingleDayHTML(parseInt(dayKey));
            }
        }

        function openDrawer(spotKey) {
            const spot = spotsDatabase[spotKey];
            if (!spot) return;

            document.getElementById('drawer-title').innerText = spot.title;
            let highlightsHTML = '';
            spot.highlights.forEach(h => {
                highlightsHTML += `<li class="flex items-start gap-2"><i class="fa-solid fa-check text-gold-400 mt-1"></i><span>${h}</span></li>`;
            });

            document.getElementById('drawer-body').innerHTML = `
                <div class="space-y-4">
                    <div class="inline-block px-3 py-1 bg-gold-500/20 text-gold-300 border border-gold-400/40 text-xs font-bold rounded-full">
                        ${spot.tag}
                    </div>
                    <div class="bg-indigo-900/60 p-3.5 rounded-xl border border-slate-700 space-y-2 text-xs">
                        <div class="flex items-center gap-2 text-slate-200">
                            <i class="fa-regular fa-clock text-gold-400 w-4"></i>
                            <span><strong>開放時間：</strong> ${spot.hours}</span>
                        </div>
                        <div class="flex items-center gap-2 text-slate-200">
                            <i class="fa-solid fa-train text-sky-400 w-4"></i>
                            <span><strong>交通指引：</strong> ${spot.access}</span>
                        </div>
                        <div class="flex items-center gap-2 text-slate-200">
                            <i class="fa-solid fa-ticket text-emerald-400 w-4"></i>
                            <span><strong>門票資訊：</strong> ${spot.fee}</span>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-bold text-white mb-2 text-xs uppercase tracking-wider text-gold-400">✨ 景點亮點與特色</h4>
                        <ul class="space-y-2 text-xs text-slate-300">
                            ${highlightsHTML}
                        </ul>
                    </div>
                    <div class="bg-gold-500/10 border border-gold-400/30 p-3.5 rounded-xl text-xs text-gold-200">
                        <strong>💡 達人小貼士：</strong> ${spot.tip}
                    </div>
                </div>
            `;

            document.getElementById('spot-drawer').classList.remove('translate-x-full');
            document.getElementById('drawer-backdrop').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('drawer-backdrop').classList.remove('opacity-0');
            }, 10);
        }

        function closeDrawer() {
            document.getElementById('spot-drawer').classList.add('translate-x-full');
            document.getElementById('drawer-backdrop').classList.add('opacity-0');
            setTimeout(() => {
                document.getElementById('drawer-backdrop').classList.add('hidden');
            }, 300);
        }

        function switchDay(dayKey) {
            renderContent(dayKey);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function shareItinerary() {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    alert("網址已成功複製到剪貼簿！可貼至 LINE 或 WhatsApp 分享。");
                }).catch(() => {
                    alert("網址複製成功！");
                });
            } else {
                alert("請複製瀏覽器網址分享給友人。");
            }
        }

        window.onload = function() {
            renderContent('all');
        };
    </script>
</body>
</html>
